// SIPADUPAS — Prisma Schema v2
// Aligned with 07-database-erd.md
// Sistem Informasi Pengamanan dan Pelayanan Terpadu Pemasyarakatan
// Lapas Kelas IIA Bontang

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ──────────────────────────────────────────────
// CORE AUTHENTICATION (ERD: users, roles, permissions, user_roles, role_permissions)
// ──────────────────────────────────────────────

model User {
  id          String    @id @default(cuid())
  nip         String    @unique
  nama        String
  email       String    @unique
  password    String    // password_hash in ERD, plain text for demo
  jabatan     String?
  noHp        String?
  isActive    Boolean   @default(true)
  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // M:N with Role via UserRole junction
  userRoles          UserRole[]
  // Direct relations
  auditLogs          AuditLog[]
  serahTerimaDari    SerahTerima[]  @relation("SerahTerimaDari")
  serahTerimaKe      SerahTerima[]  @relation("SerahTerimaKe")
  gangguanReporter   Gangguan[]     @relation("GangguanReporter")
  gangguanAssigned   Gangguan[]     @relation("GangguanAssigned")
  pengaduanResponded Pengaduan[]    @relation("PengaduanResponder")
  jadwalRegu         JadwalRegu[]
  barangVerified     BarangTitipan[] @relation("BarangVerifiedBy")

  @@index([nip])
  @@index([isActive])
}

model Role {
  id          String   @id @default(cuid())
  code        String   @unique  // SUPER_ADMIN, ADMIN_LAPAS, etc.
  name        String   // Human-readable label
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@index([code])
}

model Permission {
  id          String   @id @default(cuid())
  code        String   @unique  // e.g. wbp:create, gangguan:read
  name        String   // Human-readable name
  description String?
  createdAt   DateTime @default(now())

  rolePermissions RolePermission[]

  @@index([code])
}

model UserRole {
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([userId, roleId])
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String   // CREATE, UPDATE, DELETE, LOGIN, LOGOUT
  entityName String?  // wbp, gangguan, kunjungan, etc.
  entityId   String?  // ID of the affected entity
  oldValues  String?  // JSON string of previous values
  newValues  String?  // JSON string of new values
  detail     String?  // Human-readable description
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entityName, entityId])
  @@index([createdAt(sort: Desc)])
  @@index([userId])
}

// ──────────────────────────────────────────────
// HOUSING (ERD: wbp_block_rooms)
// Blok + Kamar merged into single table
// ──────────────────────────────────────────────

model WBPBlockRoom {
  id              String   @id @default(cuid())
  blockName       String   // "Blok A"
  roomNumber      String   // "Kamar 1", "Kamar A1"
  maxCapacity     Int      @default(0)
  currentOccupancy Int     @default(0) // denormalized, updated via app logic
  status          String   @default("Aktif")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  wbp           WBP[]
  riwayatMutasiAsal  RiwayatMutasi[]  @relation("RoomAsal")
  riwayatMutasiTujuan RiwayatMutasi[]  @relation("RoomTujuan")

  @@unique([blockName, roomNumber])
  @@index([blockName])
}

// ──────────────────────────────────────────────
// WBP INMATES (ERD: wbp_inmates)
// ──────────────────────────────────────────────

model WBP {
  id               String    @id @default(cuid())
  nomorRegister    String    @unique
  nama             String
  nik              String?
  tempatLahir      String?
  tanggalLahir     DateTime?
  jenisKelamin     String    @default("Laki-laki")
  pasal            String?
  lamaHukuman      String?   // e.g. "5 Tahun" — kept for UX
  sentenceMonths   Int?      // numeric equivalent from ERD
  tanggalEksekusi  DateTime?
  risiko           String    @default("Rendah") // Rendah, Sedang, Tinggi
  status           String    @default("Aktif") // Aktif, Rawat Inap, Kerja Luar, Isolasi, Bebas
  tanggalMasuk     DateTime  @default(now())
  catatan          String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  currentRoomId    String?
  currentRoom      WBPBlockRoom? @relation(fields: [currentRoomId], references: [id])

  riwayatMutasi      RiwayatMutasi[]
  kunjungan         Kunjungan[]
  rawatInap         WBPRawatInap[]
  kerjaLuar         WBPKerjaLuar[]
  pesertaPembinaan  PesertaPembinaan[]
  kehadiranPembinaan KehadiranPembinaan[]
  barangTitipan       BarangTitipan[]

  @@index([nomorRegister, nik])
  @@index([status])
  @@index([currentRoomId])
}

model RiwayatMutasi {
  id           String   @id @default(cuid())
  wbpId        String
  roomAsalId   String?
  roomTujuanId String?
  alasan       String?
  createdAt    DateTime @default(now())

  wbp         WBP           @relation(fields: [wbpId], references: [id], onDelete: Cascade)
  roomAsal    WBPBlockRoom? @relation("RoomAsal", fields: [roomAsalId], references: [id])
  roomTujuan  WBPBlockRoom? @relation("RoomTujuan", fields: [roomTujuanId], references: [id])

  @@index([wbpId])
}

// ──────────────────────────────────────────────
// SECURITY & SHIFT MANAGEMENT
// (ERD: shift_schedules, security_handovers, security_incidents)
// ──────────────────────────────────────────────

model ReguPengamanan {
  id        String   @id @default(cuid())
  nama      String   // Regu Alpha, Regu Bravo, etc.
  anggota   String?  // JSON array of user IDs
  status    String   @default("Aktif")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  jadwalRegu   JadwalRegu[]
  serahTerima  SerahTerima[]
}

model JadwalRegu {
  id           String   @id @default(cuid())
  reguId       String
  tanggal      String   // YYYY-MM-DD
  shift        String   // Pagi, Siang, Malam
  pos          String?  // Pos Utama, Blok A, etc.
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  regu         ReguPengamanan @relation(fields: [reguId], references: [id])
  leaderUserId String?
  leaderUser   User?          @relation(fields: [leaderUserId], references: [id], onDelete: SetNull)

  @@index([tanggal])
  @@index([reguId])
}

model SerahTerima {
  id                String    @id @default(cuid())
  tanggal           DateTime  @default(now())
  reguId            String
  reguDariId        String
  reguKeId          String
  totalWBP          Int       @default(0)
  wbpRawatInap      Int       @default(0)
  wbpKerjaLuar      Int       @default(0)
  catatanKeamanan   String?
  catatanInventaris String?
  catatanKejadian   String?
  status            String    @default("DRAFT") // DRAFT, SUBMITTED, CONFIRMED
  confirmedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  regu      ReguPengamanan @relation(fields: [reguId], references: [id])
  reguDari  User           @relation("SerahTerimaDari", fields: [reguDariId], references: [id])
  reguKe    User           @relation("SerahTerimaKe", fields: [reguKeId], references: [id])

  @@index([status])
}

model Gangguan {
  id            String    @id @default(cuid())
  nomorInsiden  String?
  tanggal       DateTime  @default(now())
  blok          String?   // plain string for location
  kamar         String?   // plain string for location
  jenis         String    // Perkelahian, Percobaan Pelarian, Narkoba, Pengrusakan, etc.
  tingkat       String    @default("Sedang") // Rendah, Sedang, Tinggi, Kritis
  kronologi     String?
  tindakanAwal  String?
  wbpTerlibat   String?   // JSON array of WBP IDs
  lampiran      String?   // file path
  status        String    @default("OPEN") // OPEN, IN_PROGRESS, RESOLVED, CLOSED
  tindakLanjut  String?
  rekomendasi   String?
  resolvedAt    DateTime?
  closedAt      DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  reporterId   String?
  reporter     User?    @relation("GangguanReporter", fields: [reporterId], references: [id])
  assignedToId String?
  assignedTo   User?    @relation("GangguanAssigned", fields: [assignedToId], references: [id])

  @@index([tingkat, status])
  @@index([status])
}

// ──────────────────────────────────────────────
// WBP RAWAT INAP (UF-09)
// ──────────────────────────────────────────────

model WBPRawatInap {
  id                String    @id @default(cuid())
  wbpId             String
  rumahSakit        String
  tanggalKeluar     DateTime  @default(now())
  tanggalKembali    DateTime?
  petugasPendamping String?
  suratRujukan      String?
  suratPerintah     String?
  kondisiKembali    String?
  status            String    @default("AKTIF") // AKTIF, KEMBALI
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  wbp WBP @relation(fields: [wbpId], references: [id])

  @@index([wbpId])
}

// ──────────────────────────────────────────────
// WBP KERJA LUAR (UF-10)
// ──────────────────────────────────────────────

model WBPKerjaLuar {
  id              String    @id @default(cuid())
  wbpId           String
  kegiatan        String
  lokasi          String?
  jamKeluar       DateTime  @default(now())
  estimasiKembali DateTime?
  jamKembali      DateTime?
  petugasPengawal String?
  keterlambatan   Boolean   @default(false)
  status          String    @default("AKTIF") // AKTIF, KEMBALI, TERLAMBAT
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  wbp WBP @relation(fields: [wbpId], references: [id])

  @@index([wbpId])
}

// ──────────────────────────────────────────────
// VISIT BOOKINGS (ERD: visit_bookings / UF-11/12)
// ──────────────────────────────────────────────

model Kunjungan {
  id            String    @id @default(cuid())
  kodeBooking   String    @unique
  namaPemohon   String
  nikPemohon    String?
  noHp          String?
  alamat        String?
  hubungan      String
  wbpId         String
  tanggal       String    // YYYY-MM-DD
  sesi          String    // Sesi 1 Pagi, Sesi 2 Siang, etc.
  status        String    @default("Menunggu") // Menunggu, Disetujui, Check-in, Selesai, Ditolak
  checkedInAt   DateTime?
  selesaiAt     DateTime?
  catatanPetugas String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  wbp WBP @relation(fields: [wbpId], references: [id])

  @@index([tanggal, status])
  @@index([kodeBooking])
  @@index([wbpId])
}

// ──────────────────────────────────────────────
// PUBLIC COMPLAINTS (ERD: public_complaints / UF-13)
// ──────────────────────────────────────────────

model Pengaduan {
  id            String    @id @default(cuid())
  kodeTracking  String    @unique
  namaPelapor   String?
  kontak        String?
  kategori      String    // Pelayanan, Pengamanan, Kunjungan, Fasilitas, Lainnya
  subjek        String
  isi           String
  isAnonim      Boolean   @default(false)
  balasan       String?
  status        String    @default("Baru") // Baru, Diverifikasi, Diproses, Selesai, Ditolak
  ditanganiOleh String?   // kept for backward compat
  selesaiAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  responderId String?
  responder   User?  @relation("PengaduanResponder", fields: [responderId], references: [id], onDelete: SetNull)

  @@index([kodeTracking])
  @@index([status])
}

// ──────────────────────────────────────────────
// PEMBINAAN (UF-15)
// ──────────────────────────────────────────────

model ProgramPembinaan {
  id        String   @id @default(cuid())
  nama      String
  kategori  String   // Pendidikan, Keagamaan, Pelatihan Kerja, Keterampilan, Olahraga, Sosial
  periode   String?
  pembina   String?
  jadwal    String?
  status    String   @default("Berjalan") // Rencana, Berjalan, Selesai
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  peserta   PesertaPembinaan[]
  kehadiran KehadiranPembinaan[]
}

model PesertaPembinaan {
  id        String   @id @default(cuid())
  programId String
  wbpId     String
  createdAt DateTime @default(now())

  program ProgramPembinaan @relation(fields: [programId], references: [id], onDelete: Cascade)
  wbp     WBP              @relation(fields: [wbpId], references: [id])

  @@unique([programId, wbpId])
}

model KehadiranPembinaan {
  id        String   @id @default(cuid())
  programId String
  wbpId     String
  tanggal   String   // YYYY-MM-DD
  status    String   @default("Hadir") // Hadir, Tidak Hadir, Izin, Sakit
  catatan   String?
  createdAt DateTime @default(now())

  program ProgramPembinaan @relation(fields: [programId], references: [id], onDelete: Cascade)
  wbp     WBP              @relation(fields: [wbpId], references: [id])

  @@unique([programId, wbpId, tanggal])
}

// ──────────────────────────────────────────────
// LAYANAN INFORMASI (UF-14)
// ──────────────────────────────────────────────

model LayananInformasi {
  id             String   @id @default(cuid())
  slug           String   @unique
  nama           String
  kategori       String   // PB, CB, CMB, Kunjungan, Pembinaan, Lainnya
  deskripsi      String?
  dasarHukum     String?
  persyaratan    String?
  alur           String?
  estimasiWaktu  String?
  templateDokumen String?
  faq            String?
  status         String   @default("Aktif")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// ──────────────────────────────────────────────
// PUBLIKASI (Berita, Galeri, Produk)
// ──────────────────────────────────────────────

model Berita {
  id         String    @id @default(cuid())
  slug       String    @unique
  judul      String
  ringkasan  String?
  isi        String?
  gambar     String?
  kategori   String?
  penulis    String?
  status     String    @default("Draft") // Draft, Terbit
  publishedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model Galeri {
  id        String   @id @default(cuid())
  judul     String
  deskripsi String?
  gambar    String?
  kategori  String?
  createdAt DateTime @default(now())
}

model ProdukWBP {
  id           String   @id @default(cuid())
  slug         String   @unique
  nama         String
  deskripsi    String?
  kategori    String?
  gambar       String?
  harga        String?
  ketersediaan String   @default("Tersedia")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ──────────────────────────────────────────────
// SKM (Survei Kepuasan Masyarakat)
// ──────────────────────────────────────────────

model SKMResponse {
  id          String   @id @default(cuid())
  nama        String?
  layanan     String?
  nilai       Float
  kritikSaran String?
  createdAt   DateTime @default(now())
}

// ──────────────────────────────────────────────
// NOTIFIKASI
// ──────────────────────────────────────────────

model Notifikasi {
  id        String   @id @default(cuid())
  userId    String?
  judul     String
  isi       String?
  jenis     String?  // urgent, info, reminder
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

// ──────────────────────────────────────────────
// BARANG TITIPAN (UF-20: Layanan Titip Barang)
// Keluarga menitipkan barang untuk WBP tanpa perlu menjenguk
// ──────────────────────────────────────────────

model BarangTitipan {
  id                String    @id @default(cuid())
  kodeTitipan       String    @unique   // auto: TRP-YYMM-NNN
  namaPengirim      String
  nikPengirim       String?
  noHp              String?
  hubungan          String    // Istri, Anak, Saudara, Orang Tua, Lainnya
  wbpId             String
  kategori          String    @default("Lainnya") // Pakaian, Makanan, Obat-obatan, Kebutuhan Sehari-hari, Lainnya
  tanggalPenitipan  String    // YYYY-MM-DD
  jamPenitipan      String?   // HH:MM
  catatanPengirim   String?
  status            String    @default("Menunggu") // Menunggu, Diverifikasi, Diterima, Ditolak
  catatanPetugas    String?
  alasanPenolakan   String?
  verifiedById      String?
  verifiedAt        DateTime?
  deliveredAt       DateTime?
  rejectedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  wbp         WBP      @relation(fields: [wbpId], references: [id])
  verifiedBy  User?    @relation("BarangVerifiedBy", fields: [verifiedById], references: [id], onDelete: SetNull)
  items       ItemBarang[]

  @@index([kodeTitipan])
  @@index([wbpId])
  @@index([status])
  @@index([tanggalPenitipan])
}

model ItemBarang {
  id               String   @id @default(cuid())
  barangTitipanId  String
  namaBarang       String
  jumlah           Int      @default(1)
  satuan           String   @default("pcs")
  keterangan       String?
  status           String   @default("Menunggu") // Menunggu, Diterima, Ditolak
  alasanPenolakan  String?
  createdAt        DateTime @default(now())

  barangTitipan BarangTitipan @relation(fields: [barangTitipanId], references: [id], onDelete: Cascade)

  @@index([barangTitipanId])
}

// ──────────────────────────────────────────────
// SECURITY EVENTS & LOGIN TRACKING
// ──────────────────────────────────────────────

model SecurityEvent {
  id        String   @id @default(cuid())
  type      String   // LOGIN_FAILED, ACCOUNT_LOCKED, RATE_LIMITED, etc.
  severity  String   @default("medium") // low, medium, high, critical
  ipAddress String?
  userAgent String?
  userId    String?
  detail    String
  metadata  String?  // JSON string
  createdAt DateTime @default(now())

  @@index([type])
  @@index([severity])
  @@index([createdAt(sort: Desc)])
  @@index([ipAddress])
}

model LoginAttempt {
  id           String    @id @default(cuid())
  nip          String
  ipAddress    String?
  userAgent    String?
  success      Boolean   @default(false)
  lockedUntil  DateTime? // If account is locked, when it unlocks
  failCount    Int       @default(0) // Current consecutive failures
  createdAt    DateTime  @default(now())

  @@index([nip])
  @@index([ipAddress])
  @@index([createdAt(sort: Desc)])
}

// ──────────────────────────────────────────────
// UF-18: BACKUP
// ──────────────────────────────────────────────

model Backup {
  id        String   @id @default(cuid())
  fileName  String
  fileSize  Int      @default(0)
  status    String   @default("SUCCESS")
  createdAt DateTime @default(now())
}
